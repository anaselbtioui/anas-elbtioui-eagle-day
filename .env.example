# Local (supabase start) — default for pnpm --filter @labas/api start
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-status-service-role

# Cloud (Vercel / local PoC against hosted): project labas / okwluptyaarwqugpdvbn
# SUPABASE_URL=https://okwluptyaarwqugpdvbn.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=from-dashboard-service-role
# Private Storage bucket: evidence (photos / PDFs via POST /api/packs/:id/photos)

PORT=8787
LABAS_JWT_SECRET=change-me-in-production
# Required for pnpm reset:db (and e2e). Never expose a reset control in the UI.
ALLOW_RESET=1

# Browser import agent (broker desk /desk/import)
# live = DeepSeek + Playwright against TRT / OuiAssur (needs key + authorised account)
# fixture = deterministic offline scenarios (CI / demo without key)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LABAS_IMPORT_MODE=fixture
LABAS_IMPORT_HEADLESS=1
